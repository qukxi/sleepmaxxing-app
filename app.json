{
  "expo": {
    "name": "sleepmaxxing-app",
    "slug": "sleepmaxxing-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.florzyk.sleepmaxxing",
      "userInterfaceStyle": "dark",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSHealthShareUsageDescription": "Sleepmaxxing requires access to your Apple Watch sleep stages, HRV, and resting heart rate to calculate your biohacking recovery score.",
        "NSHealthUpdateUsageDescription": "Sleepmaxxing requires access to sync your sleep metrics."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Sleepmaxxing requires access to your Apple Watch sleep stages, HRV, and resting heart rate to calculate your biohacking recovery score."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a5bfb488-8cf0-4112-bbe6-d3c237fb2c91"
      }
    },
    "owner": "florzyk"
  }
}
